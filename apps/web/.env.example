# Tradely Clerk application (do not reuse TradingFlow keys)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Tradely PostHog project token and US ingestion host. Browser analytics stays
# opted out until the learner explicitly allows analytics.
# Production Vercel builds require a valid phc_ project token.
VITE_POSTHOG_KEY=
# Must remain the direct Tradely US ingestion endpoint.
VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_APP_RELEASE is injected from VERCEL_GIT_COMMIT_SHA during Vercel builds.
VITE_APP_RELEASE=

# GA4 measurement ID for Tradely web. The Google tag loads only after the
# learner explicitly allows optional analytics.
VITE_GOOGLE_ANALYTICS_MEASUREMENT_ID=

# Server-side exception capture. The public project token may match
# VITE_POSTHOG_KEY; it is separated here to keep server configuration explicit.
POSTHOG_PROJECT_TOKEN=
# Must remain the direct Tradely US ingestion endpoint.
POSTHOG_HOST=https://us.i.posthog.com

# Build-time source-map upload. Production Vercel builds require this to remain
# true. POSTHOG_CLI_API_KEY must be a personal API key restricted to this
# project with error_tracking:write. Never prefix it VITE_.
POSTHOG_SOURCEMAPS_ENABLED=false
POSTHOG_CLI_HOST=https://us.posthog.com
POSTHOG_CLI_PROJECT_ID=582920
POSTHOG_CLI_API_KEY=

# Dedicated Tradely Neon database
DATABASE_URL=

# Approved Tradely Stripe account and exact offer Prices. The current product
# decision reuses one account but keeps separate test/production Prices and keys.
# Lifetime checkout can be disabled without revoking grants.
STRIPE_API_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_MEMBERSHIP_PRICE_ID=
STRIPE_COURSE_PASS_PRICE_ID=
LIFETIME_CHECKOUT_ENABLED=false
APP_URL=http://localhost:8250

# Free preview media. A relative path uses apps/web/public locally.
MEDIA_PUBLIC_BASE_URL=/media/tradingflow

# Local/private Node-host fallback. Generate a random 32+ character secret.
MEDIA_SIGNING_SECRET=
PRIVATE_MEDIA_ROOT=

# Shared Cloudflare R2 private media storage. Test and production intentionally
# use the same bucket and credentials; keep these values server-only.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_KEY_PREFIX=tradingflow-foundations
