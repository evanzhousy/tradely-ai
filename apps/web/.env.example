# Tradely Clerk application (do not reuse TradingFlow keys)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Tradely PostHog project token and US ingestion host. Browser analytics stays
# opted out until the learner explicitly allows analytics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server-side exception capture. The public project token may match
# VITE_POSTHOG_KEY; it is separated here to keep server configuration explicit.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Build-time source-map upload. POSTHOG_CLI_API_KEY must be a personal API key
# restricted to this project with error_tracking:write. Never prefix it VITE_.
POSTHOG_SOURCEMAPS_ENABLED=false
POSTHOG_CLI_HOST=https://us.posthog.com
POSTHOG_CLI_PROJECT_ID=582920
POSTHOG_CLI_API_KEY=

# Dedicated Tradely Neon database
DATABASE_URL=

# Dedicated Tradely Stripe account and exact membership Price
STRIPE_API_KEY=
STRIPE_PRICE_ID=
APP_URL=http://localhost:8250

# Free preview media. A relative path uses apps/web/public locally.
MEDIA_PUBLIC_BASE_URL=/media/tradingflow

# Local/private Node-host fallback. Generate a random 32+ character secret.
MEDIA_SIGNING_SECRET=
PRIVATE_MEDIA_ROOT=

# Shared Cloudflare R2 private media storage. Test and production intentionally
# use the same bucket and credentials; keep these values server-only.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_KEY_PREFIX=tradingflow-foundations
